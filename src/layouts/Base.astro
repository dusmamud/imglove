---
import { getDict } from '../i18n/dicts';
import { isRtl, l, asset, locales, SITE_ORIGIN } from '../i18n/index';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  locale: string;
  title: string;
  description: string;
  path: string; // locale-less path, e.g. "/compress-image" or "/"
  noindex?: boolean;
}

const { locale, title, description, path, noindex = false } = Astro.props;
const dict = getDict(locale);
const rtl = isRtl(locale);
const canonical = `${SITE_ORIGIN}${l(path, locale)}`;
---

<!doctype html>
<html lang={locale} dir={rtl ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Apply saved theme before first paint (prevents flash of wrong theme)
      (function () {
        try {
          var t = localStorage.getItem('imglove-theme') || 'system';
          var dark = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((lc) => (
      <link rel="alternate" hreflang={lc} href={`${SITE_ORIGIN}${l(path, lc)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${SITE_ORIGIN}${l(path, 'en')}`} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={dict.meta.siteName} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
  </head>
  <body class="min-h-screen bg-card font-sans text-ink">
    <Header locale={locale} dict={dict} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} dict={dict} />
  </body>
</html>
