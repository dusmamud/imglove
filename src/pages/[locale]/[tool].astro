---
import Base from '../../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { getDict, type Dict } from '../../i18n/dicts';
import { locales } from '../../i18n/index';
import { tools, toolBySlug } from '../../tools';
import CompressApp from '../../tools/compress-image/CompressApp';
import ResizeApp from '../../tools/resize-image/ResizeApp';
import CropApp from '../../tools/crop-image/CropApp';
import ConvertApp from '../../tools/convert-image/ConvertApp';
import RotateApp from '../../tools/rotate-image/RotateApp';
import WatermarkApp from '../../tools/watermark-image/WatermarkApp';
import MemeApp from '../../tools/meme-generator/MemeApp';
import PhotoEditorApp from '../../tools/photo-editor/PhotoEditorApp';
import UpscaleApp from '../../tools/upscale-image/UpscaleApp';
import BlurApp from '../../tools/blur-image/BlurApp';
import CornersApp from '../../tools/round-corners/CornersApp';
import BorderApp from '../../tools/add-border/BorderApp';
import SplitApp from '../../tools/split-image/SplitApp';
import BgRemoveApp from '../../tools/background-remover/BgRemoveApp';
import PdfApp from '../../tools/image-to-pdf/PdfApp';
import FaviconApp from '../../tools/favicon-generator/FaviconApp';
import OcrApp from '../../tools/image-to-text/OcrApp';
import GifApp from '../../tools/gif-maker/GifApp';
import HtmlImgApp from '../../tools/html-to-image/HtmlImgApp';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    tools.map((t) => ({ params: { locale, tool: t.slug } })),
  );
}

const { locale, tool } = Astro.params;
const def = tool ? toolBySlug(tool) : undefined;
if (!def || !tool) return Astro.redirect(`/${locale}/`);
const dict = getDict(locale);

const toolDict = {
  'compress-image': dict.compress,
  'resize-image': dict.resize,
  'crop-image': dict.crop,
  'convert-image': dict.convert,
  'rotate-image': dict.rotate,
  'watermark-image': dict.watermark,
  'meme-generator': dict.meme,
  'photo-editor': dict.editor,
  'upscale-image': dict.upscale,
  'blur-image': dict.blur,
  'round-corners': dict.corners,
  'add-border': dict.border,
  'split-image': dict.split,
  'background-remover': dict.bgremove,
  'image-to-pdf': dict.pdf,
  'favicon-generator': dict.favicon,
  'image-to-text': dict.ocr,
  'gif-maker': dict.gif,
  'html-to-image': dict.htmlimg,
}[tool] as Dict['compress'];

const names = dict.tools as Record<string, { name: string; desc: string }>;
const pageTitle = `${names[tool].name} — ${dict.meta.siteName}`;
---

<Base locale={locale} title={pageTitle} description={names[tool].desc} path={'/' + tool}>
  <section class="mx-auto max-w-4xl px-4 pb-8 pt-10 text-center sm:pt-14">
    <span class="mb-5 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-brand-soft text-brand">
      <Icon name={'ph:' + def.icon} class="h-8 w-8" />
    </span>
    <h1 class="text-[38px] font-semibold leading-[1.15] tracking-tight text-ink sm:text-[60px] sm:leading-[70px]">{toolDict.title}</h1>
    <p class="mx-auto mt-4 max-w-xl text-base text-muted sm:text-lg">{toolDict.desc}</p>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-6">
    <div id="tool-loading" class="mx-auto max-w-4xl rounded-card border border-line bg-white px-6 py-16 text-center">
      <div class="mx-auto mb-4 h-8 w-8 animate-spin rounded-full border-[3px] border-line border-t-brand"></div>
      <p class="text-sm text-muted">{dict.common.toolLoading}</p>
    </div>
    <div id="tool-load-error" class="mx-auto hidden max-w-4xl rounded-card border border-line bg-white px-6 py-16 text-center">
      <p class="mb-4 text-sm text-ink">{dict.common.toolLoadFailed}</p>
      <button
        type="button"
        onclick="location.reload()"
        class="rounded-lg bg-brand px-8 py-3 text-sm font-semibold text-white hover:bg-brand-dark"
      >
        {dict.common.refreshPage}
      </button>
    </div>
    <div id="tool-app">
      {tool === 'compress-image' && <CompressApp t={dict.compress} common={dict.common} client:only="react" />}
      {tool === 'resize-image' && <ResizeApp t={dict.resize} common={dict.common} client:only="react" />}
      {tool === 'crop-image' && <CropApp t={dict.crop} common={dict.common} client:only="react" />}
      {tool === 'convert-image' && <ConvertApp t={dict.convert} common={dict.common} client:only="react" />}
      {tool === 'rotate-image' && <RotateApp t={dict.rotate} common={dict.common} client:only="react" />}
      {tool === 'watermark-image' && <WatermarkApp t={dict.watermark} common={dict.common} client:only="react" />}
      {tool === 'meme-generator' && <MemeApp t={dict.meme} common={dict.common} client:only="react" />}
      {tool === 'photo-editor' && <PhotoEditorApp t={dict.editor} common={dict.common} client:only="react" />}
      {tool === 'upscale-image' && <UpscaleApp t={dict.upscale} common={dict.common} client:only="react" />}
      {tool === 'blur-image' && <BlurApp t={dict.blur} common={dict.common} client:only="react" />}
      {tool === 'round-corners' && <CornersApp t={dict.corners} common={dict.common} client:only="react" />}
      {tool === 'add-border' && <BorderApp t={dict.border} common={dict.common} client:only="react" />}
      {tool === 'split-image' && <SplitApp t={dict.split} common={dict.common} client:only="react" />}
      {tool === 'background-remover' && <BgRemoveApp t={dict.bgremove} common={dict.common} client:only="react" />}
      {tool === 'image-to-pdf' && <PdfApp t={dict.pdf} common={dict.common} client:only="react" />}
      {tool === 'favicon-generator' && <FaviconApp t={dict.favicon} common={dict.common} client:only="react" />}
      {tool === 'image-to-text' && <OcrApp t={dict.ocr} common={dict.common} client:only="react" />}
      {tool === 'gif-maker' && <GifApp t={dict.gif} common={dict.common} client:only="react" />}
      {tool === 'html-to-image' && <HtmlImgApp t={dict.htmlimg} common={dict.common} client:only="react" />}
    </div>
  </section>
  <script>
    // If the tool island fails to hydrate (stale cache, blocked JS), show a clear error instead of a dead page.
    (function () {
      var loading = document.getElementById('tool-loading');
      var errorBox = document.getElementById('tool-load-error');
      var hydrated = false;
      function check() {
        var island = document.querySelector('astro-island');
        // Hydrated island renders interactive content (buttons/inputs)
        if (island && island.querySelector('button, input')) {
          hydrated = true;
          if (loading) loading.style.display = 'none';
          return true;
        }
        return false;
      }
      if (check()) return;
      var obs = new MutationObserver(function () {
        if (check()) obs.disconnect();
      });
      obs.observe(document.body, { childList: true, subtree: true });
      setTimeout(function () {
        obs.disconnect();
        if (!hydrated && !check()) {
          if (loading) loading.style.display = 'none';
          if (errorBox) errorBox.classList.remove('hidden');
        }
      }, 12000);
    })();
  </script>

  <section class="mx-auto max-w-4xl px-4 py-10">
    <h2 class="text-center text-xl font-bold text-ink sm:text-2xl">{dict.toolPage.howItWorks}</h2>
    <ol class="mt-6 grid gap-4 sm:grid-cols-3">
      {dict.toolPage.steps.map((s, i) => (
        <li class="rounded-card border border-line bg-white p-5 text-center shadow-card">
          <span class="mx-auto mb-3 flex h-9 w-9 items-center justify-center rounded-full bg-brand text-sm font-bold text-white">
            {i + 1}
          </span>
          <p class="text-sm font-medium text-ink">{s}</p>
        </li>
      ))}
    </ol>
  </section>
</Base>
