---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { getDict } from '../i18n/dicts';
import { l } from '../i18n/index';

const locale = 'en';
const dict = getDict(locale);
---

<Base locale={locale} title={`404 — ${dict.meta.siteName}`} description={dict.notFound.desc} path="/404" noindex>
  <section class="mx-auto max-w-xl px-4 py-24 text-center">
    <Icon name="ph:file-x" class="mx-auto mb-6 h-16 w-16 text-line" />
    <h1 class="text-3xl font-bold text-ink">404</h1>
    <p class="mt-2 text-lg font-semibold text-ink">{dict.notFound.title}</p>
    <p class="mt-2 text-sm text-muted">{dict.notFound.desc}</p>
    <a href={l('/', locale)} class="mt-6 inline-block rounded-btn bg-brand px-8 py-3 text-sm font-semibold text-white hover:bg-brand-dark">
      {dict.notFound.backHome}
    </a>
  </section>
</Base>
