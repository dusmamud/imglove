---
import { Icon } from 'astro-icon/components';
import { l, localeNames, locales } from '../i18n/index';
import { tools } from '../tools';
import type { Dict } from '../i18n/dicts';

interface Props {
  locale: string;
  dict: Dict;
}
const { locale, dict } = Astro.props;
const toolNames = dict.tools as Record<string, { name: string }>;
---

<footer class="mt-20 bg-[#26262e] text-[#b9b9c4]">
  <div class="mx-auto grid max-w-[1370px] gap-10 px-6 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <nav aria-label={dict.footer.colProduct}>
      <p class="mb-4 text-xs font-bold uppercase tracking-widest text-white">{dict.footer.colProduct}</p>
      <ul class="space-y-2.5">
        <li><a href={l('/', locale)} class="text-sm hover:text-white">{dict.nav.home}</a></li>
        <li><a href={l('/#features', locale)} class="text-sm hover:text-white">{dict.nav.features}</a></li>
        <li><a href={l('/#tools', locale)} class="text-sm hover:text-white">{dict.nav.tools}</a></li>
        <li><a href={l('/#faq', locale)} class="text-sm hover:text-white">{dict.nav.faq}</a></li>
      </ul>
    </nav>
    <nav aria-label={dict.footer.colTools}>
      <p class="mb-4 text-xs font-bold uppercase tracking-widest text-white">{dict.footer.colTools}</p>
      <ul class="space-y-2.5">
        {tools.map((t) => (
          <li>
            <a href={l('/' + t.slug, locale)} class="text-sm hover:text-white">{toolNames[t.slug].name}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label={dict.footer.colLegal}>
      <p class="mb-4 text-xs font-bold uppercase tracking-widest text-white">{dict.footer.colLegal}</p>
      <ul class="space-y-2.5">
        <li><a href={l('/privacy', locale)} class="text-sm hover:text-white">{dict.footer.privacy}</a></li>
        <li><a href={l('/terms', locale)} class="text-sm hover:text-white">{dict.footer.terms}</a></li>
      </ul>
    </nav>
    <nav aria-label={dict.footer.colCompany}>
      <p class="mb-4 text-xs font-bold uppercase tracking-widest text-white">{dict.footer.colCompany}</p>
      <ul class="space-y-2.5">
        <li><a href={l('/about', locale)} class="text-sm hover:text-white">{dict.footer.about}</a></li>
      </ul>
      <p class="mt-6 flex items-center gap-1.5">
        <svg viewBox="0 0 512 512" class="mr-2 h-6 w-6" fill="#4d90fe" aria-hidden="true"><path fill-rule="evenodd" d="M171 165 C171 125 212 100 256 100 C300 100 341 125 341 165 C335 250 310 330 256 438 C202 330 177 250 171 165 Z M252 408 L260 408 L259 266 L253 266 Z M243 250 C243 257.18 248.82 263 256 263 C263.18 263 269 257.18 269 250 C269 242.82 263.18 237 256 237 C248.82 237 243 242.82 243 250 Z"/></svg>
        <span class="font-brand text-base font-bold text-white">Image <span class="text-brand">Quill</span></span>
      </p>
      <p class="mt-2 text-xs leading-relaxed">{dict.footer.tagline}</p>
      <p class="mt-3 text-xs">
        <a href="https://dusrel.com" target="_blank" rel="noopener" class="text-[#b9b9c4] underline-offset-2 hover:text-white hover:underline">{dict.footer.byDusrel}</a>
      </p>
    </nav>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-[1370px] flex-col items-center justify-between gap-4 px-6 py-5 text-xs sm:flex-row">
      <details class="relative">
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-white/25 px-4 py-2 font-medium text-white [&::-webkit-details-marker]:hidden">
          <Icon name="ph:globe" class="h-4 w-4" />
          {localeNames[locale as keyof typeof localeNames]}
          <Icon name="ph:caret-down" class="h-3.5 w-3.5" />
        </summary>
        <div class="absolute bottom-full end-0 z-50 mb-2 max-h-72 w-44 overflow-y-auto rounded-card border border-line bg-card py-1 shadow-pop">
          {locales.map((lc) => (
            <a
              href={l('/', lc)}
              class={`block px-4 py-2 text-sm hover:bg-soft ${lc === locale ? 'font-semibold text-brand' : 'text-ink'}`}
            >
              {localeNames[lc as keyof typeof localeNames]}
            </a>
          ))}
        </div>
      </details>
      <p>© {new Date().getFullYear()} {dict.meta.siteName} ® — {dict.footer.rights}</p>
    </div>
  </div>
</footer>
